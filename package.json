{
  "name": "kepos-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:build": "bunx @tailwindcss/cli -i ./styles/launcher.css -o ./www/launcher.css --minify",
    "android:sync": "bun run web:build && cap sync android",
    "android:apk": "bun run android:sync && cd android && JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home ./gradlew assembleDebug",
    "android:install": "bun run android:apk && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.38",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
