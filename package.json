{
  "name": "kepos-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:build": "bunx @tailwindcss/cli -i ./styles/launcher.css -o ./www/launcher.css --minify && bun build ./src/launcher.ts --outdir ./www --minify",
    "android:sync": "bun run web:build && cap sync android",
    "android:apk": "bun run android:sync && cd android && ./gradlew \"-Pandroid.aapt2FromMavenOverride=$ANDROID_HOME/build-tools/35.0.0/aapt2\" assembleDebug",
    "android:install": "bun run android:apk && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor-community/media": "9.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "8",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.38",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
